# Copy to `.env.local` for local dev or set these in your host / Docker / systemd environment for production or staging tests.
# Never commit `.env.local` or paste live keys into git — keep secrets in CI/host secrets only.
#
# Tunnel tip (ngrok / Cloudflare trycloudflare): `next dev` opens a WebSocket at `/_next/webpack-hmr`; free tunnels often drop it (harmless noise). For a clean remote URL use production-style serving: `npm run preview` after filling `.env.local`.

# Supabase — Dashboard → Project Settings → API
# (Example project: pv-leads — paste keys from the dashboard; do not commit real keys.)
NEXT_PUBLIC_SUPABASE_URL=https://fomoqlaejooneksnuday.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only (cron jobs, discovery pipeline). Do not expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: protects POST /api/cron/daily-discovery. When unset, that route accepts requests without this header (fine only for trusted networks).
# For the in-app “Run agent” button to send the Bearer token, set NEXT_PUBLIC_CRON_SECRET to the same value as CRON_SECRET (staging/testing only).
CRON_SECRET=
NEXT_PUBLIC_CRON_SECRET=
